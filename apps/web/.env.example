# Demo UI (no backend). Set to false for live API + swarm.
VITE_USE_MOCK=true

# Supabase Auth (required for Google / email signup)
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Optional: override Vite → Worker proxy target (default http://127.0.0.1:8787)
# VITE_API_ORIGIN=http://127.0.0.1:8787
