ENVIRONMENT=development
DEV_AUTH_BYPASS=true
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Required for live LLM specs + eng codegen (also set via `wrangler secret put` in prod)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash

# Supabase Auth (verify JWTs + ownership). Prefer secrets in production.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
