FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY runtime/package.json runtime/tsconfig.json runtime/server.ts ./
RUN npm install --omit=dev \
  && npm install --no-save typescript @types/node \
  && npx tsc

FROM node:22-bookworm-slim

WORKDIR /app
COPY --from=build /app/dist/server.js ./server.js
COPY runtime/package.json ./package.json

ENV PORT=8080
EXPOSE 8080

CMD ["node", "server.js"]
