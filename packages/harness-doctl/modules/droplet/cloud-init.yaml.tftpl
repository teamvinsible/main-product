#cloud-config
# GENERATED by @ansi2u/harness-doctl (droplet module). Hardens the host, joins the
# private Headscale tailnet (no public SSH), and points Docker's data-root at the
# encrypted block volume so all container data (incl. Postgres) is encrypted at rest.
package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - gnupg
  - ufw
  - unattended-upgrades

users:
  - name: deploy
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    ssh_authorized_keys: ${jsonencode(ssh_public_keys)}

write_files:
  - path: /etc/ssh/sshd_config.d/90-harness-hardening.conf
    permissions: '0644'
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      X11Forwarding no
      AllowAgentForwarding no
  - path: /etc/docker/daemon.json
    permissions: '0644'
    content: |
      {
        "data-root": "/mnt/docker",
        "log-driver": "json-file",
        "log-opts": { "max-size": "10m", "max-file": "3" },
        "live-restore": true,
        "no-new-privileges": true,
        "userland-proxy": false
      }
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: '0644'
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";

bootcmd:
  - mkdir -p /mnt/docker

runcmd:
  # 1) Mount the encrypted block volume as Docker's data-root (all container data).
  - DEV=$(readlink -f /dev/disk/by-id/scsi-0DO_Volume_${data_volume_name} 2>/dev/null || true)
  - if [ -n "$DEV" ]; then (blkid "$DEV" || mkfs.ext4 -F "$DEV"); mount "$DEV" /mnt/docker; grep -q "/mnt/docker" /etc/fstab || echo "$DEV /mnt/docker ext4 defaults,nofail,discard 0 2" >> /etc/fstab; fi
  # 2) Docker engine + compose plugin (uses the data-root configured above).
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable --now docker
  # 3) Join the private tailnet; enable tailscale SSH (admin path). No public SSH.
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --login-server=${headscale_url} --authkey=${tailscale_authkey} --hostname=${hostname} --ssh --accept-dns=false
  # 4) Host firewall (defense in depth behind the DO Cloud Firewall).
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw --force enable
  # 5) Apply SSH hardening.
  - systemctl restart ssh || systemctl restart sshd || true
