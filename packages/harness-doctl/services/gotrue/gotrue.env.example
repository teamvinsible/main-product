# GoTrue config. Non-secret defaults live here; secret + $env values are injected
# from SOPS-decrypted env at deploy time via infra-config.json. Do NOT put secrets
# in this file — the `artifacts/no-inline-secrets` gate will flag them.

GOTRUE_DB_DRIVER=postgres
# DATABASE_URL=${GOTRUE_DATABASE_URL}   # postgres://authenticator:...@postgres_main/main
# GOTRUE_JWT_SECRET=${JWT_SECRET}       # shared with PostgREST so RLS sees the claims
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated

# SITE_URL / mailer / providers
# GOTRUE_SITE_URL=${SITE_URL}
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_MAILER_AUTOCONFIRM=false

# Email provider (email/password)
GOTRUE_EXTERNAL_EMAIL_ENABLED=true

# OAuth providers — enable per spec.resources.auth.providers. Secrets via $env.
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
# GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
# GOTRUE_EXTERNAL_GOOGLE_SECRET=${GOOGLE_SECRET}
# GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=${SITE_URL}/auth/callback
