# PostgREST config. Connects as the `authenticator` role (see postgres init roles);
# every request runs as web_anon or authenticated, with RLS enforcing row access.
# Secrets ($env) are injected from SOPS at deploy time.

# PGRST_DB_URI=${POSTGREST_DATABASE_URL}   # postgres://authenticator:...@postgres_main/main
PGRST_DB_ANON_ROLE=web_anon
PGRST_DB_SCHEMAS=public
# PGRST_JWT_SECRET=${JWT_SECRET}           # MUST match GoTrue's secret
PGRST_JWT_AUD=authenticated

# Hardening
PGRST_DB_MAX_ROWS=1000
PGRST_SERVER_PORT=3000
PGRST_DB_PREPARED_STATEMENTS=true
PGRST_DB_CHANNEL_ENABLED=false
