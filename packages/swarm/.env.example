# Agent Swarm — environment configuration (copy to .env and fill in).
#
# LOCAL DEV: use this file directly (cp .env.example .env).
# PRODUCTION VPS: use Doppler instead — secrets never touch disk.
#   See deploy/vps/README.md#doppler and deploy/vps/doppler-secrets.template
#   Only /etc/doppler/agent-swarm.env holds the Doppler Service Token.

# ── Database ────────────────────────────────────────────────────────────────
# Source of truth for projects, runs, logs, agent output, evals, learnings.
DATABASE_URL=postgres://swarm:swarm@localhost:5432/swarm

# ── LLM providers (configure at least one) ──────────────────────────────────
# claude: Claude Agent SDK (uses Claude Code auth when logged in; key optional).
ANTHROPIC_API_KEY=

# anthropic: raw Messages API (requires ANTHROPIC_API_KEY).
# deepseek: requires DEEPSEEK_API_KEY — https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_FALLBACK_MODEL=
DEEPSEEK_TIMEOUT_MS=

# openrouter: one key for many models — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=

SWARM_ANTHROPIC_TIMEOUT_MS=
SWARM_PROVIDER_ATTEMPTS=3

# ── GitHub ──────────────────────────────────────────────────────────────────
# Required for repo commits, branches, PRs, CI repair. Needs "repo" scope.
GITHUB_TOKEN=
GH_TOKEN=
# Named profiles: GITHUB_TOKEN_<PROFILE>  (e.g. GITHUB_TOKEN_CLIENT_A)

# ── Remote dashboard / VPS ──────────────────────────────────────────────────
# Production VPS: SWARM_BIND=127.0.0.1 — Caddy terminates TLS on :443. Never expose :3456 publicly.
SWARM_BIND=127.0.0.1
# Required on VPS. Generate: openssl rand -hex 32
SWARM_DASHBOARD_TOKEN=
# Extra CORS origins (comma-separated), e.g. https://swarm.example.com
SWARM_ALLOWED_ORIGINS=
# Public HTTPS URL (for webhook registration, cron examples)
SWARM_PUBLIC_URL=

# Optional outbound delivery for the durable in-app notification inbox.
SWARM_NOTIFICATION_WEBHOOK_URL=
# Sent as an Authorization: Bearer header when configured.
SWARM_NOTIFICATION_WEBHOOK_TOKEN=

# ── GitHub webhooks (inbound triggers) ──────────────────────────────────────
SWARM_GITHUB_WEBHOOK_SECRET=
# Comma-separated allowlist, e.g. owner/repo,owner/other
SWARM_GITHUB_ALLOWED_REPOS=

# ── Google Chat (inbound app + outbound status webhook) ─────────────────────
# Inbound: HTTP app endpoint at /api/webhooks/google-chat (see README).
# Set audience URL to match Google Chat app config (recommended):
SWARM_GOOGLE_CHAT_AUDIENCE_URL=
# Or use project-number auth mode instead of audience URL:
SWARM_GOOGLE_CHAT_PROJECT_NUMBER=
# Comma-separated allowlists (empty = allow all)
SWARM_GOOGLE_CHAT_ALLOWED_USERS=
SWARM_GOOGLE_CHAT_ALLOWED_SPACES=
# Outbound status push: incoming webhook URL from Google Chat space settings
SWARM_GOOGLE_CHAT_WEBHOOK_URL=
# Dev only — skip JWT verification (never enable on production VPS)
SWARM_GOOGLE_CHAT_SKIP_VERIFY=

# ── Skills ──────────────────────────────────────────────────────────────────
# Extra skill directories (comma-separated). Defaults: skills/, .swarm/skills/, workspace skills/
SWARM_SKILLS_PATHS=

# ── Agent runtime tuning ────────────────────────────────────────────────────
SWARM_MAX_REVIEW_ROUNDS=5
SWARM_PHASE_REPAIR_ROUNDS=
SWARM_AGENT_HEARTBEAT_MS=
SWARM_REPEATED_TOOL_LIMIT=4
SWARM_EMPTY_TOOL_RESULT_LIMIT=5
SWARM_WEB_FETCH_TIMEOUT_MS=
# true = lead review fails closed on parse errors (recommended on VPS)
SWARM_LEAD_STRICT=

# ── Docker sandbox ──────────────────────────────────────────────────────────
# off | exec | full
SWARM_SANDBOX=exec
SWARM_SANDBOX_IMAGE=node:22-bookworm
SWARM_SANDBOX_CPUS=
SWARM_SANDBOX_MEMORY=
SWARM_SANDBOX_NETWORK=
SWARM_SANDBOX_READONLY=
SWARM_SANDBOX_DROP_CAPS=
SWARM_SANDBOX_PIDS=512
SWARM_SHELL_ENV_ALLOW=
SWARM_SHELL_ENV_DENY=

# ── Git / CI repair ─────────────────────────────────────────────────────────
SWARM_WORKTREES=off
SWARM_CI_REPAIR=off
SWARM_CI_REPAIR_ROUNDS=3
SWARM_CI_REPAIR_TIMEOUT_MS=1200000

# ── Supabase migrations (privileged executor) ─────────────────────────────────
SWARM_MIGRATION_APPLY_REMOTE=
SWARM_MIGRATION_ENVIRONMENT=staging
SWARM_MIGRATION_PRODUCTION_APPROVED=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=

# ── Deploy providers (swarm deploy + generated apps) ────────────────────────
VERCEL_TOKEN=
DIGITALOCEAN_TOKEN=
GCP_SA_KEY=
GCP_PROJECT=
GCP_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Named profiles: VERCEL_TOKEN_<PROFILE>, DIGITALOCEAN_TOKEN_<PROFILE>, etc.
