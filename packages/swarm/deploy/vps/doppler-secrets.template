# Secrets to create in Doppler (project: agent-swarm, config: prd)
# https://docs.doppler.com/docs/install-cli
#
# Copy each key name exactly. Values are managed in Doppler — NOT in .env on disk.

# ── Required ──
DATABASE_URL=postgres://swarm:<POSTGRES_PASSWORD>@127.0.0.1:5432/swarm
POSTGRES_PASSWORD=<generate-strong-password>
SWARM_DASHBOARD_TOKEN=<openssl rand -hex 32>

# ── LLM (at least one) ──
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ── Optional providers ──
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── GitHub ──
GITHUB_TOKEN=

# ── VPS / dashboard ──
SWARM_BIND=127.0.0.1
SWARM_PUBLIC_URL=https://swarm.yourdomain.com
SWARM_ALLOWED_ORIGINS=https://swarm.yourdomain.com
SWARM_SANDBOX=exec

# ── Telegram ──
SWARM_TELEGRAM_BOT_TOKEN=
SWARM_TELEGRAM_CHAT_ID=
SWARM_TELEGRAM_ALLOWED_USERS=
SWARM_TELEGRAM_WEBHOOK_SECRET=

# ── GitHub webhooks ──
SWARM_GITHUB_WEBHOOK_SECRET=
SWARM_GITHUB_ALLOWED_REPOS=

# ── Google Chat ──
SWARM_GOOGLE_CHAT_AUDIENCE_URL=
SWARM_GOOGLE_CHAT_PROJECT_NUMBER=
SWARM_GOOGLE_CHAT_ALLOWED_USERS=
SWARM_GOOGLE_CHAT_ALLOWED_SPACES=
SWARM_GOOGLE_CHAT_WEBHOOK_URL=

# ── Deploy (optional) ──
VERCEL_TOKEN=
DIGITALOCEAN_TOKEN=

# ── Supabase migrations (optional) ──
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=
